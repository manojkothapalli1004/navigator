# Navigator configuration reference
#
# Navigator is configured by NAVIGATOR_* ENVIRONMENT VARIABLES read by Settings.from_env().
# This file documents each one with its code default; it is not loaded by the app. Set the
# vars in your shell or in the launchd plist's EnvironmentVariables block.
# Code defaults are the safe profile: fake driver + dry_run (proposes, never mutates git).

[driver]
driver = "fake"                 # NAVIGATOR_DRIVER: "fake" (deterministic) | "claude_sdk" (live)
sdk_model = ""                  # NAVIGATOR_SDK_MODEL: e.g. "claude-opus-5-5" (live deployment)
# Optional per-role model overrides (unset = use NAVIGATOR_SDK_MODEL):
#   NAVIGATOR_SDK_MODEL_PLANNER, NAVIGATOR_SDK_MODEL_BUILDER, NAVIGATOR_SDK_MODEL_VERIFIER
sdk_timeout_s = 300.0           # NAVIGATOR_SDK_TIMEOUT_S: wall-clock cap per SDK query

[mode]
mode = "dry_run"                # NAVIGATOR_MODE: "dry_run" proposes only; "execute" runs approved
                                # proposals and acts on merge decisions

[services]
act_base_url = ""               # NAVIGATOR_ACT_BASE_URL: unset = in-memory FakeACTClient
                                # (operator CLI defaults to http://127.0.0.1:8090)
orc_base_url = ""               # NAVIGATOR_ORC_BASE_URL: unset = FakeORCClient

[runtime]
repo = ""                       # NAVIGATOR_REPO: target git repository (required)
worktree_root = "/tmp/navigator-worktrees"     # NAVIGATOR_WORKTREE_ROOT
lock_path = "/tmp/navigator.lock"              # NAVIGATOR_LOCK_PATH: single-flight lock
outcome_path = "/tmp/navigator-outcomes.jsonl" # NAVIGATOR_OUTCOME_PATH: local outcome trail
tick_interval_s = 900           # NAVIGATOR_TICK_INTERVAL_S

[planner]
max_proposals_per_tick = 3      # NAVIGATOR_MAX_PROPOSALS_PER_TICK
max_open_proposals = 10         # NAVIGATOR_MAX_OPEN_PROPOSALS: planner pauses at this backlog
proposal_ttl_days = 7           # NAVIGATOR_PROPOSAL_TTL_DAYS: unreviewed proposals expire
memory_chars_per_section = 3000 # NAVIGATOR_MEMORY_CHARS_PER_SECTION: ORC memory budget

[safety]
max_cost_usd = 2.0              # NAVIGATOR_MAX_COST_USD: per-run budget (> 0)
max_tool_failures = 5           # NAVIGATOR_MAX_TOOL_FAILURES (>= 1)
max_identical_failures = 3      # NAVIGATOR_MAX_IDENTICAL_FAILURES
max_run_duration_s = 1800       # NAVIGATOR_MAX_RUN_DURATION_S
max_failed_tests = 50           # NAVIGATOR_MAX_FAILED_TESTS
command_timeout_s = 60          # NAVIGATOR_COMMAND_TIMEOUT_S: per verifier command; a fresh
                                # worktree's `uv run pytest` builds a venv first (~3 min)
# NAVIGATOR_ALLOWED_COMMANDS: comma-separated bare command prefixes (no '/', no shell
# metacharacters). argv-only, no shell; LLM-issued git commands are limited to a safe-flag set.
allowed_commands = ["git status", "git diff", "git log", "pytest", "python3 -m py_compile", "uv run pytest"]

[notify]
# Telegram alerts (optional; sending is best-effort). Either set both direct vars:
#   NAVIGATOR_TELEGRAM_BOT_TOKEN, NAVIGATOR_TELEGRAM_CHAT_ID
# or point at an existing bot .env holding TELEGRAM_BOT_TOKEN and AUTHORIZED_CHAT_ID:
notify_env_file = ""            # NAVIGATOR_NOTIFY_ENV_FILE
