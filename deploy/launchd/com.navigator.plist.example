<?xml version="1.0" encoding="UTF-8"?>
<!--
  Navigator launchd daemon template. Replace /ABSOLUTE/PATH placeholders, then:
    cp com.navigator.plist.example ~/Library/LaunchAgents/com.calwbot.navigator.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.calwbot.navigator.plist
  Keep NAVIGATOR_MODE=dry_run until you intend Navigator to execute approved proposals.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.calwbot.navigator</string>

  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/navigator/.venv/bin/python</string>
    <string>-m</string>
    <string>navigator</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/ABSOLUTE/PATH/TO/navigator</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>NAVIGATOR_DRIVER</key>              <string>claude_sdk</string>
    <key>NAVIGATOR_SDK_MODEL</key>           <string>claude-opus-5-5</string>
    <key>NAVIGATOR_MODE</key>                <string>dry_run</string>
    <key>NAVIGATOR_REPO</key>                <string>/ABSOLUTE/PATH/TO/target-repo</string>
    <key>NAVIGATOR_ACT_BASE_URL</key>        <string>http://127.0.0.1:8090</string>
    <key>NAVIGATOR_ORC_BASE_URL</key>        <string>http://127.0.0.1:8100</string>
    <key>NAVIGATOR_WORKTREE_ROOT</key>       <string>/tmp/navigator-worktrees</string>
    <key>NAVIGATOR_LOCK_PATH</key>           <string>/tmp/navigator.lock</string>
    <key>NAVIGATOR_OUTCOME_PATH</key>        <string>/ABSOLUTE/PATH/TO/logs/outcomes.jsonl</string>
    <key>NAVIGATOR_TICK_INTERVAL_S</key>     <string>900</string>
    <key>NAVIGATOR_NOTIFY_ENV_FILE</key>     <string>/ABSOLUTE/PATH/TO/telegram-bot/.env</string>
    <key>PATH</key>                          <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/ABSOLUTE/PATH/TO/logs/navigator.out.log</string>
  <key>StandardErrorPath</key>
  <string>/ABSOLUTE/PATH/TO/logs/navigator.err.log</string>
</dict>
</plist>
