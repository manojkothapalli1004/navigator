     cost_usd_total: Mapped[float] = mapped_column(default=0.0)                 # reserved for v1
     created_at: Mapped[datetime]
     updated_at: Mapped[datetime]
+
+
+# ---------------------------------------------------------------------------
+# Navigator agent resource — three tables: agent_proposals, agent_runs,
+# agent_approvals. Ids are prefixed strings (e.g. "proposal-<ulid>") so the
+# PKs are String(64), not String(26). Identifying / queryable fields are
+# explicit columns; the full object lives in a JSON `payload` column, exactly
+# like EventRow. See docs/superpowers/specs/2026-05-27-navigator-v0-plan.md.
+# ---------------------------------------------------------------------------
+
+
+class AgentProposalRow(Base):
+    __tablename__ = "agent_proposals"
+
+    id: Mapped[str] = mapped_column(String(64), primary_key=True)         # "proposal-<ulid>"
+    schema_version: Mapped[int]
+    # proposed|approved|declined|expired|superseded
+    status: Mapped[str] = mapped_column(String(16), index=True)
+    origin: Mapped[str] = mapped_column(String(64))
+    proposal_origin_hash: Mapped[str] = mapped_column(String(64), index=True)
+    repo: Mapped[str] = mapped_column(String(256))
+    base_commit_sha: Mapped[str] = mapped_column(String(64))
+    risk_tier: Mapped[str] = mapped_column(String(16))
+    priority: Mapped[int]
+    created_at: Mapped[datetime]
+    payload: Mapped[dict[str, Any]] = mapped_column(JSON, default=dict)
+
+    __table_args__ = (
+        Index("idx_agent_proposals_status_created", "status", "created_at"),
+    )
+
+
+class AgentRunRow(Base):
+    __tablename__ = "agent_runs"
+
+    id: Mapped[str] = mapped_column(String(64), primary_key=True)         # "run-<ulid>"
+    schema_version: Mapped[int]
+    proposal_id: Mapped[str] = mapped_column(String(64), index=True)
+    # executing|completed|failed|rolled_back|aborted
+    status: Mapped[str] = mapped_column(String(16), index=True)
+    phase: Mapped[str] = mapped_column(String(32))
+    base_commit_sha: Mapped[str] = mapped_column(String(64))
+    branch: Mapped[str] = mapped_column(String(256))
+    worktree_path: Mapped[str | None] = mapped_column(String(512))
+    correlation_id: Mapped[str | None] = mapped_column(String(64))
+    started_at: Mapped[datetime]
+    ended_at: Mapped[datetime | None]
+    cost_usd: Mapped[float] = mapped_column(default=0.0)
+    payload: Mapped[dict[str, Any]] = mapped_column(JSON, default=dict)
+
+
+class AgentApprovalRow(Base):
+    __tablename__ = "agent_approvals"
+
+    id: Mapped[str] = mapped_column(String(64), primary_key=True)         # "approval-<ulid>"
+    schema_version: Mapped[int]
+    target: Mapped[str] = mapped_column(String(64), index=True)
+    # review|merge|architecture|destructive|budget|deploy
+    gate: Mapped[str] = mapped_column(String(16), index=True)
+    # pending|approved|declined
+    decision: Mapped[str] = mapped_column(String(16), index=True)
+    actor: Mapped[str | None] = mapped_column(String(64))
+    decided_at: Mapped[datetime | None]
+    note: Mapped[str | None] = mapped_column(Text)
+    correlation_id: Mapped[str | None] = mapped_column(String(64))
