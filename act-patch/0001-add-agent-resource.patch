+"""Navigator agent-resource event kinds.
+
+Events are emitted via the existing EventIngestService (act.events.ingest).
+Kind format follows the ACT convention: "{source}.{resource}.{action}".
+"""
+from __future__ import annotations
+
+from typing import Any
+
+# Source identifier — every event from the Navigator agent resource uses this.
+NAVIGATOR_SOURCE = "navigator"
+
+# Proposal kinds
+KIND_PROPOSAL_CREATED = "agent.proposal.created"
+KIND_PROPOSAL_STATUS_CHANGED = "agent.proposal.status_changed"
+
+# Run kinds
+KIND_RUN_CREATED = "agent.run.created"
+KIND_RUN_UPDATED = "agent.run.updated"
+
+# Approval kinds
+KIND_APPROVAL_CREATED = "agent.approval.created"
+KIND_APPROVAL_DECIDED = "agent.approval.decided"
+
+
+def payload_proposal_created(
+    *, proposal_id: str, origin: str, repo: str, risk_tier: str, priority: int
+) -> dict[str, Any]:
+    return {
+        "proposal_id": proposal_id,
+        "origin": origin,
+        "repo": repo,
+        "risk_tier": risk_tier,
+        "priority": priority,
+    }
+
+
+def payload_proposal_status_changed(
+    *, proposal_id: str, status: str
+) -> dict[str, Any]:
+    return {"proposal_id": proposal_id, "status": status}
+
+
+def payload_run_created(
+    *, run_id: str, proposal_id: str, branch: str, base_commit_sha: str
+) -> dict[str, Any]:
+    return {
+        "run_id": run_id,
+        "proposal_id": proposal_id,
+        "branch": branch,
+        "base_commit_sha": base_commit_sha,
+    }
+
+
+def payload_run_updated(
+    *, run_id: str, status: str, phase: str
+) -> dict[str, Any]:
+    return {"run_id": run_id, "status": status, "phase": phase}
+
+
+def payload_approval_created(
+    *, approval_id: str, target: str, gate: str
+) -> dict[str, Any]:
+    return {"approval_id": approval_id, "target": target, "gate": gate}
+
+
+def payload_approval_decided(
+    *, approval_id: str, target: str, gate: str, decision: str, actor: str | None
+) -> dict[str, Any]:
+    return {
+        "approval_id": approval_id,
+        "target": target,
+        "gate": gate,
+        "decision": decision,
+        "actor": actor,
+    }
