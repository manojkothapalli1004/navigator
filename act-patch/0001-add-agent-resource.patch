@@ -0,0 +1,271 @@
+"""API tests for the Navigator agent resource.
+
+Mirrors test_events.py: in-memory SQLite, TestClient, get_session override.
+Covers proposals, runs, approvals, and that a source="navigator" event is
+written into the same DB on a transition.
+"""
+from __future__ import annotations
+
+import pytest
+from fastapi.testclient import TestClient
+from sqlalchemy import create_engine, event, select
+from sqlalchemy.orm import sessionmaker
+from sqlalchemy.pool import StaticPool
+
+from act.api.v1.deps import get_session
+from act.main import app
+from act.persistence.db import Base
+from act.persistence.models import (  # noqa: F401
+    AgentApprovalRow,
+    AgentProposalRow,
+    AgentRunRow,
+    AlertRow,
+    CursorRow,
+    EventRow,
+    SnapshotRow,
+    SourceHealthRow,
+)
+
+
+@pytest.fixture
+def client():
+    engine = create_engine(
+        "sqlite:///:memory:",
+        future=True,
+        connect_args={"check_same_thread": False},
+        poolclass=StaticPool,
+    )
+
+    @event.listens_for(engine, "connect")
+    def _fk_on(dbapi_conn, _record):
+        cur = dbapi_conn.cursor()
+        cur.execute("PRAGMA foreign_keys=ON")
+        cur.close()
+
+    Base.metadata.create_all(engine)
+    SessionFactory = sessionmaker(bind=engine, expire_on_commit=False, autoflush=False)
+
+    def _override_session():
+        s = SessionFactory()
+        try:
+            yield s
+        finally:
+            s.close()
+
+    app.dependency_overrides[get_session] = _override_session
+    with TestClient(app) as c:
+        c._session_factory = SessionFactory  # type: ignore[attr-defined]
+        yield c
+    app.dependency_overrides.clear()
+    engine.dispose()
+
+
+def _make_proposal_body(**overrides) -> dict:
+    body = {
+        "origin": "navigator-planner",
+        "proposal_origin_hash": "deadbeef",
+        "repo": "calwbot/trader",
+        "base_commit_sha": "abc123",
+        "risk_tier": "low",
+        "priority": 5,
+        "payload": {"title": "tweak", "rationale": "because"},
+    }
+    body.update(overrides)
+    return body
+
+
+# ---- proposals ------------------------------------------------------------
+
+
+def test_create_and_list_proposal(client) -> None:
+    r = client.post("/api/v1/agent/proposals", json=_make_proposal_body())
+    assert r.status_code == 200, r.text
+    body = r.json()
+    assert body["id"].startswith("proposal-")
+    assert body["status"] == "proposed"
+    assert body["repo"] == "calwbot/trader"
+    assert body["payload"]["title"] == "tweak"
+
+    r2 = client.get("/api/v1/agent/proposals")
+    assert r2.status_code == 200
+    assert len(r2.json()) == 1
+    assert r2.json()[0]["id"] == body["id"]
+
+
+def test_list_proposals_filters_by_status(client) -> None:
+    p1 = client.post("/api/v1/agent/proposals", json=_make_proposal_body()).json()
+    client.post("/api/v1/agent/proposals", json=_make_proposal_body())
+
+    client.post(
+        f"/api/v1/agent/proposals/{p1['id']}/status", json={"status": "approved"}
+    )
+
+    r_all = client.get("/api/v1/agent/proposals")
+    assert len(r_all.json()) == 2
+    r_approved = client.get("/api/v1/agent/proposals?status=approved")
+    assert [p["id"] for p in r_approved.json()] == [p1["id"]]
+    r_proposed = client.get("/api/v1/agent/proposals?status=proposed")
+    assert len(r_proposed.json()) == 1
+
+
+def test_set_proposal_status(client) -> None:
+    p = client.post("/api/v1/agent/proposals", json=_make_proposal_body()).json()
+    r = client.post(
+        f"/api/v1/agent/proposals/{p['id']}/status", json={"status": "declined"}
+    )
+    assert r.status_code == 200
+    assert r.json()["status"] == "declined"
+
+
+def test_set_proposal_status_404(client) -> None:
+    r = client.post(
+        "/api/v1/agent/proposals/proposal-missing/status",
+        json={"status": "approved"},
+    )
+    assert r.status_code == 404
+
+
+# ---- runs -----------------------------------------------------------------
+
+
+def _make_run_body(proposal_id: str, **overrides) -> dict:
+    body = {
+        "proposal_id": proposal_id,
+        "phase": "init",
+        "base_commit_sha": "abc123",
+        "branch": "agent/run-1",
+        "worktree_path": "var/worktrees/run-1",
+        "correlation_id": "corr-1",
+        "payload": {"completed_tasks": []},
+    }
+    body.update(overrides)
+    return body
+
+
+def test_create_run_list_open_and_update(client) -> None:
+    p = client.post("/api/v1/agent/proposals", json=_make_proposal_body()).json()
+
+    r = client.post("/api/v1/agent/runs", json=_make_run_body(p["id"]))
+    assert r.status_code == 200, r.text
+    run = r.json()
+    assert run["id"].startswith("run-")
+    assert run["status"] == "executing"
+    assert run["proposal_id"] == p["id"]
+
+    r_open = client.get("/api/v1/agent/runs")
+    assert [x["id"] for x in r_open.json()] == [run["id"]]
+
+    r_upd = client.post(
+        f"/api/v1/agent/runs/{run['id']}",
+        json={"status": "completed", "phase": "done", "cost_usd": 1.25},
+    )
+    assert r_upd.status_code == 200
+    assert r_upd.json()["status"] == "completed"
+    assert r_upd.json()["phase"] == "done"
+    assert r_upd.json()["cost_usd"] == 1.25
+
+    # completed run no longer appears in open list
+    assert client.get("/api/v1/agent/runs").json() == []
+
+
+def test_update_run_404(client) -> None:
+    r = client.post("/api/v1/agent/runs/run-missing", json={"status": "aborted"})
+    assert r.status_code == 404
+
+
+# ---- approvals ------------------------------------------------------------
+
+
+def test_create_decide_and_list_approval(client) -> None:
+    r = client.post(
+        "/api/v1/agent/approvals",
+        json={"target": "run-xyz", "gate": "merge", "correlation_id": "corr-9"},
+    )
+    assert r.status_code == 200, r.text
+    appr = r.json()
+    assert appr["id"].startswith("approval-")
+    assert appr["decision"] == "pending"
+    assert appr["gate"] == "merge"
+
+    r_dec = client.post(
+        f"/api/v1/agent/approvals/{appr['id']}/decide",
+        json={"decision": "approved", "actor": "operator", "note": "lgtm"},
+    )
+    assert r_dec.status_code == 200
+    decided = r_dec.json()
+    assert decided["decision"] == "approved"
+    assert decided["actor"] == "operator"
+    assert decided["note"] == "lgtm"
+    assert decided["decided_at"] is not None
+
+    r_app = client.get("/api/v1/agent/approvals?decision=approved")
+    assert [a["id"] for a in r_app.json()] == [appr["id"]]
+    r_pend = client.get("/api/v1/agent/approvals?decision=pending")
+    assert r_pend.json() == []
+    r_tgt = client.get("/api/v1/agent/approvals?target=run-xyz&gate=merge")
+    assert len(r_tgt.json()) == 1
+
+
+def test_decide_approval_404(client) -> None:
+    r = client.post(
+        "/api/v1/agent/approvals/approval-missing/decide",
+        json={"decision": "approved"},
+    )
+    assert r.status_code == 404
+
+
+# ---- event emission -------------------------------------------------------
+
+
+def _navigator_events(client) -> list[EventRow]:
+    with client._session_factory() as s:
+        return list(
+            s.scalars(
+                select(EventRow).where(EventRow.source == "navigator")
+            ).all()
+        )
+
+
+def test_proposal_creation_writes_navigator_event(client) -> None:
+    p = client.post("/api/v1/agent/proposals", json=_make_proposal_body()).json()
+    events = _navigator_events(client)
+    kinds = {e.kind for e in events}
+    assert "agent.proposal.created" in kinds
+    created = next(e for e in events if e.kind == "agent.proposal.created")
+    assert created.source == "navigator"
+    assert created.severity == "info"
+    assert created.correlation_id == p["id"]
+    assert created.payload["proposal_id"] == p["id"]
+
+
+def test_status_transition_writes_navigator_event(client) -> None:
+    p = client.post("/api/v1/agent/proposals", json=_make_proposal_body()).json()
+    client.post(
+        f"/api/v1/agent/proposals/{p['id']}/status", json={"status": "approved"}
+    )
+    kinds = [e.kind for e in _navigator_events(client)]
+    assert "agent.proposal.status_changed" in kinds
+
+
+def test_failed_run_update_emits_error_severity(client) -> None:
+    p = client.post("/api/v1/agent/proposals", json=_make_proposal_body()).json()
+    run = client.post("/api/v1/agent/runs", json=_make_run_body(p["id"])).json()
+    client.post(f"/api/v1/agent/runs/{run['id']}", json={"status": "failed"})
+    events = _navigator_events(client)
+    updated = [e for e in events if e.kind == "agent.run.updated"]
+    assert updated
+    assert updated[-1].severity == "error"
+
+
+def test_approval_decision_writes_navigator_event(client) -> None:
+    appr = client.post(
+        "/api/v1/agent/approvals",
+        json={"target": "run-xyz", "gate": "review"},
+    ).json()
+    client.post(
+        f"/api/v1/agent/approvals/{appr['id']}/decide",
+        json={"decision": "declined"},
+    )
