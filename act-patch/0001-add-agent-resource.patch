--- /dev/null
+++ b/backend/act/api/v1/agent.py
@@ -0,0 +1,376 @@
+"""Navigator agent-resource API.
+
+Endpoints serve Navigator's HTTPACTClient — proposals, runs, approvals. Each
+create / transition persists its row AND an EventRow with source="navigator"
+in the same request session (so the event is durable and transactionally
+consistent with the state change), then best-effort publishes on the bus to
+mirror ACT's existing event-driven path.
+"""
+from __future__ import annotations
+
+from datetime import UTC, datetime
+from typing import Any
+
+import structlog
+from fastapi import APIRouter, Depends, HTTPException, Query
+from sqlalchemy.orm import Session
+
+from act.api.v1.deps import get_session
+from act.api.v1.schemas import (
+    ApprovalCreateRequest,
+    ApprovalDecideRequest,
+    ApprovalResponse,
+    ProposalCreateRequest,
+    ProposalResponse,
+    ProposalStatusRequest,
+    RunCreateRequest,
+    RunResponse,
+    RunUpdateRequest,
+)
+from act.domain.event import Event, Severity
+from act.domain.ids import new_ulid
+from act.events.bus import get_bus
+from act.events.navigator import (
+    KIND_APPROVAL_CREATED,
+    KIND_APPROVAL_DECIDED,
+    KIND_PROPOSAL_CREATED,
+    KIND_PROPOSAL_STATUS_CHANGED,
+    KIND_RUN_CREATED,
+    KIND_RUN_UPDATED,
+    NAVIGATOR_SOURCE,
+    payload_approval_created,
+    payload_approval_decided,
+    payload_proposal_created,
+    payload_proposal_status_changed,
+    payload_run_created,
+    payload_run_updated,
+)
+from act.persistence.models import (
+    AgentApprovalRow,
+    AgentProposalRow,
+    AgentRunRow,
+)
+from act.persistence.repositories import (
+    AgentApprovalRepository,
+    AgentProposalRepository,
+    AgentRunRepository,
+    EventRepository,
+)
+
+router = APIRouter(prefix="/agent", tags=["agent"])
+
+log = structlog.get_logger()
+
+MAX_LIMIT = 500
+DEFAULT_LIMIT = 100
+
+
+def _emit(
+    s: Session,
+    *,
+    kind: str,
+    payload: dict[str, Any],
+    correlation_id: str | None,
+    severity: Severity = "info",
+) -> Event:
+    """Persist a navigator event into the request session (caller commits)."""
+    ev = Event(
+        id=new_ulid(),
+        source=NAVIGATOR_SOURCE,
+        kind=kind,
+        severity=severity,
+        ts=datetime.now(UTC),
+        payload=payload,
+        correlation_id=correlation_id,
+        agent_id=None,
+    )
+    EventRepository(s).add(ev)
+    return ev
+
+
+async def _publish(ev: Event) -> None:
+    try:
+        await get_bus().publish(ev)
+    except Exception:  # event publish must never break the response
+        log.exception("navigator_event_publish_failed", kind=ev.kind)
+
+
+# ---- proposals ------------------------------------------------------------
+
+
+def _proposal_to_response(row: AgentProposalRow) -> ProposalResponse:
+    return ProposalResponse(
+        id=row.id,
+        schema_version=row.schema_version,
+        status=row.status,
+        origin=row.origin,
+        proposal_origin_hash=row.proposal_origin_hash,
+        repo=row.repo,
+        base_commit_sha=row.base_commit_sha,
+        risk_tier=row.risk_tier,
+        priority=row.priority,
+        created_at=row.created_at,
+        payload=row.payload,
+    )
+
+
+@router.post("/proposals", response_model=ProposalResponse)
+async def create_proposal(
+    req: ProposalCreateRequest,
+    s: Session = Depends(get_session),  # noqa: B008
+) -> ProposalResponse:
+    now = datetime.now(UTC)
+    proposal_id = f"proposal-{new_ulid()}"
+    row = AgentProposalRow(
+        id=proposal_id,
+        schema_version=req.schema_version,
+        status="proposed",
+        origin=req.origin,
+        proposal_origin_hash=req.proposal_origin_hash,
+        repo=req.repo,
+        base_commit_sha=req.base_commit_sha,
+        risk_tier=req.risk_tier,
+        priority=req.priority,
+        created_at=now,
+        payload=req.payload,
+    )
+    AgentProposalRepository(s).add(row)
+    ev = _emit(
+        s,
+        kind=KIND_PROPOSAL_CREATED,
+        payload=payload_proposal_created(
+            proposal_id=proposal_id,
+            origin=req.origin,
+            repo=req.repo,
+            risk_tier=req.risk_tier,
+            priority=req.priority,
+        ),
+        correlation_id=proposal_id,
+    )
+    s.commit()
+    await _publish(ev)
+    return _proposal_to_response(row)
+
+
+@router.get("/proposals", response_model=list[ProposalResponse])
+def list_proposals(
+    status: str | None = Query(default=None),
+    limit: int = Query(default=DEFAULT_LIMIT, ge=1),
+    s: Session = Depends(get_session),  # noqa: B008
+) -> list[ProposalResponse]:
+    rows = AgentProposalRepository(s).list(status=status, limit=min(limit, MAX_LIMIT))
+    return [_proposal_to_response(r) for r in rows]
+
+
+@router.post("/proposals/{proposal_id}/status", response_model=ProposalResponse)
+async def set_proposal_status(
+    proposal_id: str,
+    req: ProposalStatusRequest,
+    s: Session = Depends(get_session),  # noqa: B008
+) -> ProposalResponse:
+    row = AgentProposalRepository(s).set_status(proposal_id, req.status)
+    if row is None:
+        raise HTTPException(status_code=404, detail="proposal_not_found")
+    ev = _emit(
+        s,
+        kind=KIND_PROPOSAL_STATUS_CHANGED,
+        payload=payload_proposal_status_changed(
+            proposal_id=proposal_id, status=req.status
+        ),
+        correlation_id=proposal_id,
+    )
+    s.commit()
+    await _publish(ev)
+    return _proposal_to_response(row)
+
+
+# ---- runs -----------------------------------------------------------------
+
+
+def _run_to_response(row: AgentRunRow) -> RunResponse:
+    return RunResponse(
+        id=row.id,
+        schema_version=row.schema_version,
+        proposal_id=row.proposal_id,
+        status=row.status,
+        phase=row.phase,
+        base_commit_sha=row.base_commit_sha,
+        branch=row.branch,
+        worktree_path=row.worktree_path,
+        correlation_id=row.correlation_id,
+        started_at=row.started_at,
+        ended_at=row.ended_at,
+        cost_usd=row.cost_usd,
+        payload=row.payload,
+    )
+
+
+@router.post("/runs", response_model=RunResponse)
+async def create_run(
+    req: RunCreateRequest,
+    s: Session = Depends(get_session),  # noqa: B008
+) -> RunResponse:
+    now = datetime.now(UTC)
+    run_id = f"run-{new_ulid()}"
+    row = AgentRunRow(
+        id=run_id,
+        schema_version=req.schema_version,
+        proposal_id=req.proposal_id,
+        status="executing",
+        phase=req.phase,
+        base_commit_sha=req.base_commit_sha,
+        branch=req.branch,
+        worktree_path=req.worktree_path,
+        correlation_id=req.correlation_id,
+        started_at=now,
+        ended_at=None,
+        cost_usd=req.cost_usd,
+        payload=req.payload,
+    )
+    AgentRunRepository(s).add(row)
+    ev = _emit(
+        s,
+        kind=KIND_RUN_CREATED,
+        payload=payload_run_created(
+            run_id=run_id,
+            proposal_id=req.proposal_id,
+            branch=req.branch,
+            base_commit_sha=req.base_commit_sha,
+        ),
+        correlation_id=req.correlation_id or run_id,
+    )
+    s.commit()
+    await _publish(ev)
+    return _run_to_response(row)
+
+
+@router.get("/runs", response_model=list[RunResponse])
+def list_open_runs(
+    limit: int = Query(default=DEFAULT_LIMIT, ge=1),
+    s: Session = Depends(get_session),  # noqa: B008
+) -> list[RunResponse]:
+    rows = AgentRunRepository(s).list_open(limit=min(limit, MAX_LIMIT))
+    return [_run_to_response(r) for r in rows]
+
+
+@router.post("/runs/{run_id}", response_model=RunResponse)
+async def update_run(
+    run_id: str,
+    req: RunUpdateRequest,
+    s: Session = Depends(get_session),  # noqa: B008
+) -> RunResponse:
+    repo = AgentRunRepository(s)
+    row = repo.update(
+        run_id,
+        status=req.status,
+        phase=req.phase,
+        worktree_path=req.worktree_path,
+        ended_at=req.ended_at,
+        cost_usd=req.cost_usd,
+        payload=req.payload,
+    )
+    if row is None:
+        raise HTTPException(status_code=404, detail="run_not_found")
+    severity: Severity = "error" if row.status == "failed" else "info"
+    ev = _emit(
+        s,
+        kind=KIND_RUN_UPDATED,
+        payload=payload_run_updated(
+            run_id=run_id, status=row.status, phase=row.phase
+        ),
+        correlation_id=row.correlation_id or run_id,
+        severity=severity,
+    )
+    s.commit()
+    await _publish(ev)
+    return _run_to_response(row)
+
+
+# ---- approvals ------------------------------------------------------------
+
+
+def _approval_to_response(row: AgentApprovalRow) -> ApprovalResponse:
+    return ApprovalResponse(
+        id=row.id,
+        schema_version=row.schema_version,
+        target=row.target,
+        gate=row.gate,
+        decision=row.decision,
+        actor=row.actor,
+        decided_at=row.decided_at,
+        note=row.note,
+        correlation_id=row.correlation_id,
+    )
+
+
+@router.post("/approvals", response_model=ApprovalResponse)
+async def create_approval(
+    req: ApprovalCreateRequest,
+    s: Session = Depends(get_session),  # noqa: B008
+) -> ApprovalResponse:
+    approval_id = f"approval-{new_ulid()}"
+    row = AgentApprovalRow(
+        id=approval_id,
+        schema_version=req.schema_version,
+        target=req.target,
+        gate=req.gate,
+        decision="pending",
+        actor=None,
+        decided_at=None,
+        note=None,
+        correlation_id=req.correlation_id,
+    )
+    AgentApprovalRepository(s).add(row)
+    ev = _emit(
+        s,
+        kind=KIND_APPROVAL_CREATED,
+        payload=payload_approval_created(
+            approval_id=approval_id, target=req.target, gate=req.gate
+        ),
+        correlation_id=req.correlation_id or approval_id,
+    )
+    s.commit()
+    await _publish(ev)
+    return _approval_to_response(row)
+
+
+@router.post("/approvals/{approval_id}/decide", response_model=ApprovalResponse)
+async def decide_approval(
+    approval_id: str,
+    req: ApprovalDecideRequest,
+    s: Session = Depends(get_session),  # noqa: B008
+) -> ApprovalResponse:
+    row = AgentApprovalRepository(s).decide(
+        approval_id, decision=req.decision, actor=req.actor, note=req.note
+    )
+    if row is None:
+        raise HTTPException(status_code=404, detail="approval_not_found")
+    ev = _emit(
+        s,
+        kind=KIND_APPROVAL_DECIDED,
+        payload=payload_approval_decided(
+            approval_id=approval_id,
+            target=row.target,
+            gate=row.gate,
+            decision=req.decision,
+            actor=req.actor,
+        ),
+        correlation_id=row.correlation_id or approval_id,
+    )
+    s.commit()
+    await _publish(ev)
+    return _approval_to_response(row)
+
+
+@router.get("/approvals", response_model=list[ApprovalResponse])
+def list_approvals(
+    target: str | None = Query(default=None),
+    gate: str | None = Query(default=None),
+    decision: str | None = Query(default=None),
+    limit: int = Query(default=DEFAULT_LIMIT, ge=1),
+    s: Session = Depends(get_session),  # noqa: B008
+) -> list[ApprovalResponse]:
+    rows = AgentApprovalRepository(s).list(
+        target=target, gate=gate, decision=decision, limit=min(limit, MAX_LIMIT)
+    )
+    return [_approval_to_response(r) for r in rows]
