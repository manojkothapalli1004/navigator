+# ---------------------------------------------------------------------------
+# Navigator agent resource — repositories for agent_proposals, agent_runs,
+# agent_approvals. Return raw rows; mapping to pydantic happens at the API edge.
+# ---------------------------------------------------------------------------
+
+
+class AgentProposalRepository:
+    def __init__(self, session: Session) -> None:
+        self.s = session
+
+    def add(self, row: AgentProposalRow) -> None:
+        self.s.add(row)
+
+    def get(self, proposal_id: str) -> AgentProposalRow | None:
+        return self.s.get(AgentProposalRow, proposal_id)
+
+    def list(
+        self, status: str | None = None, limit: int = 100
+    ) -> list[AgentProposalRow]:
+        stmt = select(AgentProposalRow)
+        if status is not None:
+            stmt = stmt.where(AgentProposalRow.status == status)
+        stmt = stmt.order_by(AgentProposalRow.created_at.desc()).limit(limit)
+        return list(self.s.scalars(stmt).all())
+
+    def set_status(self, proposal_id: str, status: str) -> AgentProposalRow | None:
+        row = self.s.get(AgentProposalRow, proposal_id)
+        if row is None:
+            return None
+        row.status = status
+        return row
+
+
+class AgentRunRepository:
+    def __init__(self, session: Session) -> None:
+        self.s = session
+
+    def add(self, row: AgentRunRow) -> None:
+        self.s.add(row)
+
+    def get(self, run_id: str) -> AgentRunRow | None:
+        return self.s.get(AgentRunRow, run_id)
+
+    def list_open(self, limit: int = 100) -> list[AgentRunRow]:
+        stmt = (
+            select(AgentRunRow)
+            .where(AgentRunRow.status == "executing")
+            .order_by(AgentRunRow.started_at.desc())
+            .limit(limit)
+        )
+        return list(self.s.scalars(stmt).all())
+
+    def list_for_proposal(self, proposal_id: str) -> list[AgentRunRow]:
+        stmt = (
+            select(AgentRunRow)
+            .where(AgentRunRow.proposal_id == proposal_id)
+            .order_by(AgentRunRow.started_at.desc())
+        )
+        return list(self.s.scalars(stmt).all())
+
+    def update(
+        self,
+        run_id: str,
+        *,
+        status: str | None = None,
+        phase: str | None = None,
+        worktree_path: str | None = None,
+        ended_at: datetime | None = None,
+        cost_usd: float | None = None,
+        payload: dict[str, object] | None = None,
+    ) -> AgentRunRow | None:
+        row = self.s.get(AgentRunRow, run_id)
+        if row is None:
+            return None
+        if status is not None:
+            row.status = status
+        if phase is not None:
+            row.phase = phase
+        if worktree_path is not None:
+            row.worktree_path = worktree_path
+        if ended_at is not None:
+            row.ended_at = ended_at
+        if cost_usd is not None:
+            row.cost_usd = cost_usd
+        if payload is not None:
+            row.payload = payload
+        return row
+
+
+class AgentApprovalRepository:
+    def __init__(self, session: Session) -> None:
+        self.s = session
+
+    def add(self, row: AgentApprovalRow) -> None:
+        self.s.add(row)
+
+    def get(self, approval_id: str) -> AgentApprovalRow | None:
+        return self.s.get(AgentApprovalRow, approval_id)
+
+    def list(
+        self,
+        target: str | None = None,
+        gate: str | None = None,
+        decision: str | None = None,
+        limit: int = 100,
+    ) -> list[AgentApprovalRow]:
+        stmt = select(AgentApprovalRow)
+        if target is not None:
+            stmt = stmt.where(AgentApprovalRow.target == target)
+        if gate is not None:
+            stmt = stmt.where(AgentApprovalRow.gate == gate)
+        if decision is not None:
+            stmt = stmt.where(AgentApprovalRow.decision == decision)
+        stmt = stmt.limit(limit)
+        return list(self.s.scalars(stmt).all())
+
+    def decide(
+        self, approval_id: str, decision: str, actor: str | None, note: str | None
+    ) -> AgentApprovalRow | None:
+        row = self.s.get(AgentApprovalRow, approval_id)
+        if row is None:
+            return None
+        row.decision = decision
+        row.actor = actor
+        row.note = note
+        row.decided_at = _now()
+        return row
+
+
