+    op.drop_table('agent_approvals')
+
+    op.drop_index('ix_agent_runs_status', table_name='agent_runs')
+    op.drop_index('ix_agent_runs_proposal_id', table_name='agent_runs')
+    op.drop_table('agent_runs')
+
+    op.drop_index(
+        'ix_agent_proposals_proposal_origin_hash', table_name='agent_proposals'
+    )
+    op.drop_index('ix_agent_proposals_status', table_name='agent_proposals')
+    op.drop_index(
+        'idx_agent_proposals_status_created', table_name='agent_proposals'
+    )
+    op.drop_table('agent_proposals')
